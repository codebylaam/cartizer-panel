{
  "heading": "Create Customer",
  "description": "Enter customer information to add them to your store.",
  "submit": "Create Customer",
  "form": {
    "name": {
      "label": "Full Name",
      "placeholder": "e.g. John Doe"
    },
    "email": {
      "label": "Email Address",
      "placeholder": "e.g. john@example.com"
    },
    "phone": {
      "label": "Phone Number",
      "placeholder": "+8801912345678"
    },
    "password": {
      "label": "Password",
      "description": "Optional. The account stays unclaimed until the customer registers."
    },
    "shipping_address": {
      "toggle": "Add a shipping address",
      "address_1": {
        "label": "Address Line 1",
        "placeholder": "House, road, area"
      },
      "address_2": {
        "label": "Address Line 2",
        "placeholder": "Apartment, landmark"
      },
      "city": { "label": "City" },
      "state": { "label": "State / Division" },
      "postal_code": { "label": "Postal Code" },
      "country": { "label": "Country" }
    },
    "billing_address": {
      "toggle": "Add a billing address",
      "address_1": {
        "label": "Address Line 1",
        "placeholder": "House, road, area"
      },
      "address_2": {
        "label": "Address Line 2",
        "placeholder": "Apartment, landmark"
      },
      "city": { "label": "City" },
      "state": { "label": "State / Division" },
      "postal_code": { "label": "Postal Code" },
      "country": { "label": "Country" }
    }
  },
  "validation": {
    "name": {
      "required": "Name is required",
      "min": "Name must be at least 2 characters"
    },
    "email": {
      "required": "Email is required",
      "invalid": "Invalid email address"
    },
    "password": {
      "min": "Password must be at least 6 characters"
    },
    "address_1": {
      "required": "Address is required"
    },
    "city": {
      "required": "City is required"
    },
    "state": {
      "required": "State is required"
    },
    "postal_code": {
      "required": "Postal code is required",
      "max": "Postal code must be at most 20 characters"
    },
    "country": {
      "max": "Country must be at most 10 characters"
    }
  }
}
